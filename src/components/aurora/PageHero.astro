---
export interface Props {
  eyebrow: string;
  title: string;
  tagline?: string;
  subtitle: string;
  primaryLabel: string;
  primaryHref: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}
const { eyebrow, title, tagline, subtitle, primaryLabel, primaryHref, secondaryLabel, secondaryHref } = Astro.props;
---
<section class="hero">
  <div data-reveal>
    <div class="eyebrow">{!tagline && <span class="dot"></span>}{eyebrow}</div>
    <h1>{title}</h1>
    {tagline && <p class="tagline">{tagline}</p>}
    <p class="sub">{subtitle}</p>
    <div class="actions">
      <a href={primaryHref} class="cta">{primaryLabel}</a>
      {secondaryLabel && secondaryHref && <a href={secondaryHref} class="outline">{secondaryLabel}</a>}
    </div>
  </div>
</section>
<style>
  .hero { max-width: 1240px; margin: 0 auto; padding: clamp(72px, 12vw, 156px) clamp(20px, 5vw, 48px) clamp(48px, 8vw, 88px); text-align: center; }
  .eyebrow { display: inline-flex; align-items: center; gap: 8px; font-family: "JetBrains Mono", monospace; font-size: 12px; letter-spacing: .16em; text-transform: uppercase; color: var(--accent-solid); border: 1px solid var(--border-strong); padding: 7px 14px; border-radius: 100px; margin-bottom: 32px; }
  .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--gradient-accent); }
  h1 { font-family: "Bricolage Grotesque", sans-serif; font-weight: 700; font-size: clamp(36px, 6vw, 78px); line-height: 1.05; letter-spacing: -.03em; margin: 0 auto 26px; max-width: 18ch; text-wrap: pretty; }
  .tagline { font-family: "Bricolage Grotesque", sans-serif; font-weight: 500; font-style: italic; font-size: clamp(18px, 2.2vw, 24px); letter-spacing: -.01em; background: var(--gradient-accent); -webkit-background-clip: text; background-clip: text; color: transparent; margin: 0 0 26px; }
  .sub { font-size: 17px; line-height: 1.65; color: var(--text-secondary); max-width: 56ch; margin: 0 auto 40px; }
  .actions { display: flex; align-items: center; justify-content: center; gap: 16px; flex-wrap: wrap; }
  .cta { background: var(--gradient-accent); color: #fff; padding: 16px 30px; border-radius: 10px; font-weight: 600; font-size: 15px; box-shadow: 0 10px 30px -10px rgba(108,99,255,.6); transition: transform .25s ease; }
  .cta:hover { color: #fff; transform: translateY(-2px); }
  .outline { border: 1px solid var(--border-strong); color: var(--text-primary); padding: 16px 30px; border-radius: 10px; font-weight: 600; font-size: 15px; background: var(--bg-elevated); transition: border-color .2s ease; }
  .outline:hover { border-color: var(--accent-solid); color: var(--text-primary); }
</style>
