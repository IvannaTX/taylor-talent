---
import { services } from "../../data/aurora";
export interface Props { variant?: "brief" | "detailed"; }
const { variant = "brief" } = Astro.props;
---
<section class="wrap">
  <div data-reveal class="head">
    <div class="eyebrow">Services</div>
    <h2>{variant === "brief" ? "Four ways to build the bench." : "Engagement models built around the mandate."}</h2>
  </div>
  {variant === "brief" ? (
    <div class="grid brief">
      {services.map((svc) => (
        <div data-reveal class="cell">
          <div class="n">{svc.n}</div>
          <h3>{svc.title}</h3>
          <p>{svc.desc}</p>
        </div>
      ))}
    </div>
  ) : (
    <div class="grid detailed">
      {services.map((svc) => (
        <div data-reveal class="card">
          <div class="n">{svc.n}</div>
          <h3>{svc.title}</h3>
          <p>{svc.desc}</p>
          <div class="includes">
            {svc.includes.map((inc) => <div><span class="arrow">→</span>{inc}</div>)}
          </div>
        </div>
      ))}
    </div>
  )}
</section>
<style>
  .wrap { max-width: 1240px; margin: 0 auto; padding: clamp(72px, 10vw, 128px) clamp(20px, 5vw, 48px); }
  .head { margin-bottom: 48px; }
  .eyebrow { font-family: "JetBrains Mono", monospace; font-size: 12px; letter-spacing: .16em; text-transform: uppercase; color: var(--accent-solid); margin-bottom: 16px; }
  h2 { font-family: "Bricolage Grotesque", sans-serif; font-weight: 700; font-size: clamp(28px, 4vw, 42px); letter-spacing: -.02em; margin: 0; max-width: 16ch; }
  .grid.brief { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; background: var(--border); border: 1px solid var(--border); border-radius: 20px; overflow: hidden; }
  .grid.brief .cell { background: var(--bg); padding: 36px 30px; }
  .grid.detailed { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
  .grid.detailed .card { border: 1px solid var(--border); border-radius: 18px; padding: 34px; background: var(--bg-elevated); }
  .n { font-family: "JetBrains Mono", monospace; font-size: 22px; font-weight: 500; background: var(--gradient-accent); -webkit-background-clip: text; background-clip: text; color: transparent; margin-bottom: 20px; }
  h3 { font-family: "Bricolage Grotesque", sans-serif; font-weight: 700; font-size: 19px; margin: 0 0 12px; letter-spacing: -.01em; }
  p { font-size: 14.5px; line-height: 1.6; color: var(--text-secondary); margin: 0; }
  .grid.detailed p { margin: 0 0 20px; }
  .includes { display: flex; flex-direction: column; gap: 8px; }
  .includes div { display: flex; gap: 10px; font-size: 13px; color: var(--text-secondary); padding-top: 8px; border-top: 1px solid var(--border); }
  .arrow { color: var(--accent-solid); }
</style>
