---
import { auroraLinks } from "../../data/aurora";
export interface Props { heading: string; subheading: string; primaryLabel: string; primaryHref?: string; }
const { heading, subheading, primaryLabel, primaryHref = auroraLinks.bookCall } = Astro.props;
---
<section class="wrap">
  <div data-reveal>
    <h2>{heading}</h2>
    <p>{subheading}</p>
    <div class="actions">
      <a href={primaryHref} class="cta">{primaryLabel}</a>
      <a href={auroraLinks.linkedin} class="outline">LinkedIn ↗</a>
    </div>
  </div>
</section>
<style>
  .wrap { max-width: 1240px; margin: 0 auto; padding: clamp(88px, 12vw, 156px) clamp(20px, 5vw, 48px); text-align: center; }
  h2 { font-family: "Bricolage Grotesque", sans-serif; font-weight: 700; font-size: clamp(30px, 5vw, 52px); letter-spacing: -.025em; margin: 0 auto 24px; max-width: 18ch; }
  p { font-size: 16.5px; line-height: 1.6; color: var(--text-secondary); max-width: 50ch; margin: 0 auto 40px; }
  .actions { display: flex; align-items: center; justify-content: center; gap: 16px; flex-wrap: wrap; }
  .cta { background: var(--gradient-accent); color: #fff; padding: 16px 30px; border-radius: 10px; font-weight: 600; font-size: 15px; box-shadow: 0 10px 30px -10px rgba(108,99,255,.6); transition: transform .25s ease; }
  .cta:hover { color: #fff; transform: translateY(-2px); }
  .outline { border: 1px solid var(--border-strong); color: var(--text-primary); padding: 16px 30px; border-radius: 10px; font-weight: 600; font-size: 15px; background: var(--bg-elevated); transition: border-color .2s ease; }
  .outline:hover { border-color: var(--accent-solid); color: var(--text-primary); }
</style>
