---
import { leaderValueProps } from "../../data/aurora";
---
<section class="band">
  <div class="wrap">
    <div data-reveal class="head">
      <div class="eyebrow">What this means</div>
      <h2>A relationship, not a transaction.</h2>
    </div>
    <div data-reveal class="grid">
      {leaderValueProps.map((v) => (
        <div><h3>{v.title}</h3><p>{v.desc}</p></div>
      ))}
    </div>
  </div>
</section>
<style>
  .band { background: var(--bg-elevated); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .wrap { max-width: 1240px; margin: 0 auto; padding: clamp(72px, 10vw, 128px) clamp(20px, 5vw, 48px); }
  .head { margin-bottom: 48px; }
  .eyebrow { font-family: "JetBrains Mono", monospace; font-size: 12px; letter-spacing: .16em; text-transform: uppercase; color: var(--accent-solid); margin-bottom: 16px; }
  h2 { font-family: "Bricolage Grotesque", sans-serif; font-weight: 700; font-size: clamp(28px, 4vw, 42px); letter-spacing: -.02em; margin: 0; max-width: 20ch; }
  .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 32px; }
  h3 { font-family: "Bricolage Grotesque", sans-serif; font-weight: 700; font-size: 18.5px; margin: 0 0 10px; }
  .grid p { font-size: 14.5px; line-height: 1.62; color: var(--text-secondary); margin: 0; }
</style>
