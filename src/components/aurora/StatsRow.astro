---
import { stats } from "../../data/aurora";

export interface Props {
  embedded?: boolean;
}

const { embedded = false } = Astro.props;
const OuterTag = embedded ? "div" : "section";
---
<OuterTag class:list={["band", { embedded }]}>
  <div class="wrap">
    <div data-reveal class="stats">
      {stats.map((s) => (
        <div class="cell">
          <div class="value">{s.value}</div>
          <div class="label">{s.label}</div>
        </div>
      ))}
    </div>
  </div>
</OuterTag>
<style>
  .band { background: var(--bg-elevated); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .wrap { max-width: 1240px; margin: 0 auto; padding: clamp(64px, 9vw, 112px) clamp(20px, 5vw, 48px); }
  .band.embedded { background: transparent; border: 0; }
  .embedded .wrap { max-width: none; padding: 0; }
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--border); }
  .cell { padding: 32px 24px 8px 0; }
  .value { font-family: "Bricolage Grotesque", sans-serif; font-weight: 700; font-size: 42px; letter-spacing: -.02em; }
  .label { margin-top: 12px; font-size: 13px; line-height: 1.55; color: var(--text-secondary); }
  @media (max-width: 700px) {
    .wrap { padding: 56px 20px; }
    .embedded .wrap { padding: 0; }
    .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .cell { min-width: 0; padding: 24px 18px 24px 0; border-bottom: 1px solid var(--border); }
    .cell:nth-child(even) { padding-right: 0; padding-left: 18px; border-left: 1px solid var(--border); }
    .value { font-size: clamp(34px, 10vw, 42px); }
    .label { font-size: 13px; overflow-wrap: anywhere; }
  }
  @media (max-width: 360px) {
    .stats { grid-template-columns: minmax(0, 1fr); }
    .cell, .cell:nth-child(even) { padding: 22px 0; border-left: 0; }
  }
</style>
