---
import { stats } from "../../data/aurora";
---
<section class="band">
  <div class="wrap">
    <div data-reveal class="stats">
      {stats.map((s) => (
        <div class="cell">
          <div class="value">{s.value}</div>
          <div class="label">{s.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>
<style>
  .band { background: var(--bg-elevated); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .wrap { max-width: 1240px; margin: 0 auto; padding: clamp(64px, 9vw, 112px) clamp(20px, 5vw, 48px); }
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--border); }
  .cell { padding: 32px 24px 8px 0; }
  .value { font-family: "Bricolage Grotesque", sans-serif; font-weight: 700; font-size: 42px; letter-spacing: -.02em; }
  .label { margin-top: 12px; font-size: 13px; line-height: 1.55; color: var(--text-secondary); }
</style>
