---
import { auroraLinks } from "../../data/aurora";
---
<footer class="footer">
  <div class="inner">
    <a href="/" class="brand">
      <img src="/images/logo.png" alt="" width="24" height="24" />
      <span>Taylor Talent Partners</span>
    </a>
    <div class="links">
      <a href="/">Home</a>
      <a href="/companies">For Companies</a>
      <a href="/leaders">For Leaders</a>
      <a href={auroraLinks.linkedin}>LinkedIn</a>
    </div>
    <div class="copy">© 2026 Taylor Talent Partners · Austin, TX</div>
  </div>
</footer>
<style>
  .footer { border-top: 1px solid var(--border); }
  .inner { max-width: 1240px; margin: 0 auto; padding: 40px clamp(20px, 5vw, 48px); display: flex; align-items: center; gap: 24px; flex-wrap: wrap; }
  .brand { display: flex; align-items: center; gap: 10px; }
  .brand img { border-radius: 6px; object-fit: cover; display: block; }
  .brand span { font-family: "Bricolage Grotesque", sans-serif; font-weight: 700; font-size: 13.5px; }
  .links { display: flex; gap: 22px; font-size: 13px; color: var(--text-secondary); }
  .links a:hover { color: var(--accent-solid); }
  .copy { margin-left: auto; font-family: "JetBrains Mono", monospace; font-size: 11.5px; letter-spacing: .08em; color: var(--text-tertiary); }
</style>
