---
import { auroraLinks } from "../../data/aurora";
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const items = [
  { href: "/", label: "Home" },
  { href: "/companies", label: "For Companies" },
  { href: "/leaders", label: "For Leaders" }
];
---
<nav class="nav" aria-label="Primary">
  <div class="inner">
    <a href="/" class="brand">
      <img src="/images/logo.jpg" alt="" width="32" height="32" />
      <span>Taylor Talent Partners</span>
    </a>
    <div class="links">
      {items.map((item) => (
        <a href={item.href} class:list={["nlink", { active: path === item.href }]}>{item.label}</a>
      ))}
    </div>
    <div class="right">
      <div class="toggle" role="group" aria-label="Theme">
        <button data-theme-btn="light" aria-label="Light theme" class="tbtn">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
        </button>
        <button data-theme-btn="dark" aria-label="Dark theme" class="tbtn">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"></path></svg>
        </button>
        <button data-theme-btn="system" aria-label="System theme" class="tbtn">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="13" rx="2"></rect><path d="M8 21h8M12 17v4"></path></svg>
        </button>
      </div>
      <a href={auroraLinks.bookCall} class="cta">Book an intro call</a>
    </div>
  </div>
</nav>
<style>
  .nav { position: sticky; top: 0; z-index: 50; backdrop-filter: blur(16px); background: var(--nav-bg); border-bottom: 1px solid var(--border); }
  .inner { max-width: 1280px; margin: 0 auto; padding: 18px clamp(20px, 5vw, 48px); display: flex; align-items: center; gap: clamp(16px, 3vw, 44px); }
  .brand { display: flex; align-items: center; gap: 12px; }
  .brand img { border-radius: 8px; object-fit: cover; display: block; }
  .brand span { font-family: "Bricolage Grotesque", sans-serif; font-weight: 700; font-size: 15px; letter-spacing: -.01em; }
  .links { display: flex; align-items: center; gap: 28px; margin-left: 8px; }
  .nlink { font-size: 14px; font-weight: 500; color: var(--text-secondary); padding-bottom: 4px; border-bottom: 2px solid transparent; transition: color .2s ease; }
  .nlink.active { font-weight: 700; color: var(--text-primary); border-bottom-color: var(--accent-solid); }
  .right { margin-left: auto; display: flex; align-items: center; gap: 18px; }
  .toggle { display: flex; align-items: center; gap: 2px; padding: 3px; border-radius: 10px; background: var(--bg-elevated); border: 1px solid var(--border); }
  .tbtn { width: 30px; height: 30px; display: flex; align-items: center; justify-content: center; border-radius: 7px; border: none; cursor: pointer; background: transparent; color: var(--text-tertiary); transition: background .2s ease, color .2s ease; }
  .cta { background: var(--gradient-accent); color: #fff; padding: 10px 18px; border-radius: 8px; font-weight: 600; font-size: 13px; white-space: nowrap; box-shadow: 0 6px 18px -8px rgba(108,99,255,.6); transition: transform .2s ease; }
  .cta:hover { color: #fff; transform: translateY(-1px); }
</style>
