---
import { links } from "../../data/content";
---
<div class="wrap" id="book-a-call">
  <div data-reveal class="grid">
    <div>
      <h2>Start with a<br />30-minute call.</h2>
      <p>Bring the role, the constraint, and the deadline. You'll leave with a market read and an honest answer on whether this is a search worth running.</p>
    </div>
    <div class="links">
      <a href={links.bookCall} class="cta"><span>Book an intro call</span><span>→</span></a>
      <a href={links.email} class="outline"><span>Email direct</span><span>↗</span></a>
      <a href={links.linkedin} class="outline"><span>LinkedIn</span><span>↗</span></a>
    </div>
  </div>
</div>
<style>
  .wrap { max-width: 1120px; margin: 0 auto; padding: 104px 60px 0; }
  .grid { border-top: 1px solid rgba(18,16,14,.14); padding-top: 56px; display: grid; grid-template-columns: 1.4fr 1fr; gap: 72px; align-items: end; }
  h2 { font-family: Newsreader, Georgia, serif; font-weight: 200; font-size: 54px; line-height: 1.08; letter-spacing: -.02em; margin: 0 0 24px; text-wrap: pretty; }
  p { font-size: 16.5px; line-height: 1.65; font-weight: 300; color: #3D3833; max-width: 46ch; margin: 0; }
  .links { display: flex; flex-direction: column; gap: 14px; }
  .cta, .outline {
    padding: 18px 26px; font-family: "IBM Plex Mono", monospace; font-size: 11.5px; letter-spacing: .13em;
    text-transform: uppercase; display: flex; justify-content: space-between; transition: background .2s, border-color .2s, color .2s;
  }
  .cta { background: #12100E; color: #F7F5F2; font-weight: 500; }
  .cta:hover { background: #8C6F5C; }
  .outline { border: 1px solid rgba(18,16,14,.22); }
  .outline:hover { border-color: #8C6F5C; color: #8C6F5C; }
</style>
