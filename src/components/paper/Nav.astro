---
import { links } from "../../data/content";
---
<div class="nav">
  <a href="#top" class="brand">
    <img src="/images/logo.png" alt="Taylor Talent Partners" width="34" height="34" />
    <span>Taylor Talent<br />Partners</span>
  </a>
  <nav>
    <a href="#engagements">Engagements</a>
    <a href="#record">Track record</a>
    <a href="#founder">Founder</a>
    <a href={links.bookCall} class="cta">Book an intro call</a>
  </nav>
</div>
<style>
  .nav {
    position: sticky; top: 0; z-index: 20;
    background: rgba(247,245,242,.92); backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(18,16,14,.1);
    max-width: 1120px; margin: 0 auto; padding: 18px 60px;
    display: flex; align-items: center; gap: 40px;
  }
  .brand { display: flex; align-items: center; gap: 12px; }
  .brand span {
    font-family: "IBM Plex Mono", monospace; font-size: 11px; font-weight: 500;
    letter-spacing: .18em; text-transform: uppercase; line-height: 1.4;
  }
  nav { margin-left: auto; display: flex; align-items: center; gap: 32px; font-size: 13.5px; color: #3D3833; }
  nav a { padding-bottom: 2px; border-bottom: 1px solid transparent; transition: color .2s, border-color .2s; }
  nav a:hover { border-bottom-color: #8C6F5C; }
  .cta {
    background: #12100E; color: #F7F5F2; padding: 11px 20px;
    font-family: "IBM Plex Mono", monospace; font-size: 11px; font-weight: 500;
    letter-spacing: .13em; text-transform: uppercase; transition: background .2s;
  }
  .cta:hover { background: #8C6F5C; color: #F7F5F2; }
</style>
