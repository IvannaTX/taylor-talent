---
import { links } from "../../data/content";
---
<div class="nav">
  <a href="#top" class="brand">
    <img src="/images/logo.png" alt="Taylor Talent Partners" width="30" height="30" />
    <span>Taylor Talent Partners</span>
  </a>
  <nav>
    <a href="#engagements">01 Engagements</a>
    <a href="#record">02 Record</a>
    <a href="#founder">03 Founder</a>
    <a href={links.bookCall} class="cta">Book a call</a>
  </nav>
</div>
<style>
  .nav {
    position: sticky; top: 0; z-index: 20; background: rgba(10,10,10,.88); backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(255,255,255,.12); padding: 16px 56px; display: flex; align-items: center; gap: 40px;
  }
  .brand { display: flex; align-items: center; gap: 14px; }
  .brand span { font-family: "IBM Plex Mono", monospace; font-size: 11px; font-weight: 500; letter-spacing: .2em; text-transform: uppercase; }
  nav { margin-left: auto; display: flex; align-items: center; gap: 34px; font-family: "IBM Plex Mono", monospace; font-size: 10.5px; letter-spacing: .16em; text-transform: uppercase; color: #9A938C; }
  nav a { transition: color .2s; }
  nav a:hover { color: #C9AE95; }
  .cta { border: 1px solid #C9AE95; color: #C9AE95; padding: 10px 18px; transition: background .2s, color .2s; }
  .cta:hover { background: #C9AE95; color: #0A0A0A; }
</style>
