---
import { engagements, type EngagementItem } from "../../data/content";
---
<div class="wrap" id="engagements">
  <div data-reveal class="heading">
    <div class="accent">01 — Engagement types</div>
    <div class="rule"></div>
    <div class="muted">The role picks the engagement</div>
  </div>
  <div class="grid">
    {engagements.map((e: EngagementItem) => (
      <div data-reveal class="card">
        <div class="top"><span>{e.index}</span><span>{e.tag}</span></div>
        <h3>{e.title}</h3>
        <p>{e.description}</p>
        <div class="chips">
          {e.chips.map((c: string) => <div><span class="arrow">→</span>{c}</div>)}
        </div>
      </div>
    ))}
  </div>
</div>
<style>
  .wrap { padding: 88px 56px 0; }
  .heading { display: flex; align-items: baseline; gap: 24px; margin-bottom: 12px; }
  .accent { font-family: "IBM Plex Mono", monospace; font-size: 10.5px; letter-spacing: .2em; text-transform: uppercase; color: #C9AE95; }
  .rule { flex: 1; height: 1px; background: rgba(255,255,255,.12); }
  .muted { font-family: "IBM Plex Mono", monospace; font-size: 10.5px; letter-spacing: .16em; text-transform: uppercase; color: #8A8078; }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: rgba(255,255,255,.12); margin-top: 36px; }
  .card { background: #0A0A0A; padding: 40px 34px 38px; transition: background .25s; }
  .card:hover { background: #131313; }
  .top { display: flex; justify-content: space-between; font-family: "IBM Plex Mono", monospace; font-size: 10.5px; letter-spacing: .16em; text-transform: uppercase; color: #8A8078; margin-bottom: 44px; }
  h3 { font-weight: 300; font-size: 27px; line-height: 1.18; letter-spacing: -.025em; margin: 0 0 18px; }
  .card p { font-size: 14.5px; line-height: 1.68; font-weight: 300; color: #9A938C; margin: 0 0 28px; }
  .chips { display: flex; flex-direction: column; gap: 10px; font-family: "IBM Plex Mono", monospace; font-size: 11px; letter-spacing: .06em; color: #C9AE95; }
  .chips div { display: flex; gap: 12px; padding-top: 10px; border-top: 1px solid rgba(255,255,255,.09); }
  .arrow { color: #5E574F; }
</style>
