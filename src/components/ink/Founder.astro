---
import { founder } from "../../data/content";
---
<div class="wrap" id="founder">
  <div data-reveal class="heading">
    <div class="accent">03 — Founder</div>
    <div class="rule"></div>
    <div class="muted">One point of contact</div>
  </div>
  <div data-reveal class="card">
    <div class="left">
      <img src="/images/founder.jpg" alt={founder.name} width="240" height="240" />
      <div class="name">{founder.name}</div>
      <div class="role">{founder.role}<br />{founder.location}</div>
    </div>
    <div class="right">
      <p class="lead">{founder.lead}</p>
      <p class="bio">{founder.bio}</p>
      <div class="cols">
        <div>
          <div class="label">In-house</div>
          <div class="items">{founder.inHouse.map((v: string) => <>{v}<br /></>)}</div>
        </div>
        <div>
          <div class="label">Agency-side</div>
          <div class="items">{founder.agencySide.map((v: string) => <>{v}<br /></>)}</div>
        </div>
        <div>
          <div class="label">Functions</div>
          <div class="items">GTM · Exec · Product<br />CS · G&amp;A<br />Legal · Technical</div>
        </div>
      </div>
    </div>
  </div>
</div>
<style>
  .wrap { padding: 88px 56px 0; }
  .heading { display: flex; align-items: baseline; gap: 24px; margin-bottom: 44px; }
  .accent { font-family: "IBM Plex Mono", monospace; font-size: 10.5px; letter-spacing: .2em; text-transform: uppercase; color: #C9AE95; }
  .rule { flex: 1; height: 1px; background: rgba(255,255,255,.12); }
  .muted { font-family: "IBM Plex Mono", monospace; font-size: 10.5px; letter-spacing: .16em; text-transform: uppercase; color: #8A8078; }
  .card { display: grid; grid-template-columns: 300px 1fr; gap: 72px; align-items: start; padding-bottom: 80px; border-bottom: 1px solid rgba(255,255,255,.12); }
  .left img { width: 240px; height: 240px; border-radius: 50%; object-fit: cover; margin-bottom: 28px; }
  .name { font-weight: 300; font-size: 28px; letter-spacing: -.02em; margin-bottom: 10px; }
  .role { font-family: "IBM Plex Mono", monospace; font-size: 10.5px; letter-spacing: .16em; text-transform: uppercase; color: #C9AE95; line-height: 1.9; }
  .lead { font-weight: 300; font-size: 30px; line-height: 1.36; letter-spacing: -.024em; margin: 0 0 28px; max-width: 34ch; text-wrap: pretty; }
  .bio { font-size: 15px; line-height: 1.72; font-weight: 300; color: #9A938C; margin: 0 0 40px; max-width: 62ch; }
  .cols { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: rgba(255,255,255,.12); }
  .cols > div { background: #0A0A0A; padding: 22px 24px; }
  .label { font-family: "IBM Plex Mono", monospace; font-size: 10px; letter-spacing: .16em; text-transform: uppercase; color: #8A8078; margin-bottom: 12px; }
  .items { font-family: "IBM Plex Mono", monospace; font-size: 12.5px; line-height: 1.8; color: #EDEAE6; }
</style>
